# Copiar en el servidor → cp .env.production.example .env && nano .env
# Luego: npm run build && pm2 restart vos-front --update-env
#
# Local NO uses este archivo; usá .env.local.example → .env.local
# ⚠️ En producción NO dejes .env.local (pisa VITE_API_URL al compilar).

VITE_PLATFORM_MODE=true
VITE_SHOP_SLUG=arandano
VITE_BRAND_NAME=VOS IA
VITE_BRAND_TAGLINE=Sistema operativo inteligente para empresas.

# URL del API vista desde el NAVEGADOR (mismo protocolo que el front).
# Con Nginx + HTTPS en vos-ia.com:
VITE_API_URL=https://vos-ia.com/backend
#
# Solo pruebas por IP (front y API ambos en http):
# VITE_API_URL=http://51.222.24.228:3001

# URLs públicas del front
VITE_APP_URL=https://vos-ia.com
VITE_LANDING_URL=https://vos-ia.com/#/
VITE_SHOP_FRONT_URL=https://vos-ia.com
VITE_SHOP_URL=https://vos-ia.com/#/tienda/arandano

# Client ID público de Google (no es el secret)
VITE_GOOGLE_CLIENT_ID=9205255049-3gtmvp6m0k9hr8repro9gd0d9ad23qsi.apps.googleusercontent.com

# WhatsApp asesor (solo build)
# VITE_LANDING_WHATSAPP_URL=https://wa.me/57XXXXXXXXXX?text=Hola
